{
  "name": "@navu-co/api-node",
  "version": "0.1.3",
  "description": "Node.js library for accessing the Navu API to programmatically access data about your website.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "navu",
    "api",
    "analytics",
    "website",
    "visitors",
    "ai",
    "chat"
  ],
  "author": "Navu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/navu-co/api-node.git"
  },
  "bugs": {
    "url": "https://github.com/navu-co/api-node/issues"
  },
  "homepage": "https://github.com/navu-co/api-node#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "publishConfig": {
    "access": "public"
  }
}